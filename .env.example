# Plantilla del `.env` de un despliegue. Copiar como `.env` en el directorio
# del cliente y completar. **Nunca commitear el `.env` real.**

# Identificador del despliegue. Nombra el contenedor, su sidecar y su red.
PANEL_SLUG=complejos-padel
PANEL_DOMAIN=panel.ejemplo.com.ar

# Lo que ve el cliente arriba a la izquierda. El panel es transversal: el
# branding sale de acá y no del código.
PANEL_NAME=Panel

# Generar con: openssl rand -hex 32
#
# 🔴 De este valor se deriva además la clave con la que se cifran las
# credenciales de cada sucursal. Rotarlo deja las guardadas ilegibles y hay que
# volver a cargarlas todas (el panel lo dice en la fila de cada una, no revienta).
SECRET_KEY=

# Generar con: openssl rand -hex 24
POSTGRES_PASSWORD=

# Admin inicial. Sólo se usa la primera vez, cuando la tabla `usuarios` está
# vacía. Después la contraseña se cambia desde la pantalla — que es la razón
# por la que este panel usa SessionAuth y no credenciales por entorno.
LIBRA_PANEL_ADMIN_USERNAME=admin
LIBRA_PANEL_ADMIN_PASSWORD=

# Segundos por sucursal. Corto a propósito: una sucursal colgada no puede dejar
# al dueño mirando un spinner.
TIMEOUT_SUCURSAL=6
